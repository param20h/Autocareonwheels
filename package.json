{
  "name": "car-service-monorepo",
  "version": "1.0.0",
  "description": "Car Service Booking Website Monorepo",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client && rm -rf dist && cp -R client/dist dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "5.22.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cloudinary": "2.9.0",
    "nodemailer": "^10.2.1"
  },
  "overrides": {
    "tar": "^7.5.16",
    "@mapbox/node-pre-gyp": {
      "tar": "^7.5.16"
    },
    "bcrypt": {
      "@mapbox/node-pre-gyp": "^2.0.3"
    },
    "server": {
      "tar": "^7.5.16",
      "@mapbox/node-pre-gyp": "^2.0.3"
    },
    "form-data": "^4.0.6",
    "shell-quote": "^1.11.0",
    "qs": "^6.16.1",
    "brace-expansion": "^5.0.6",
    "follow-redirects": "^1.16.1",
    "proxy-addr": "^2.0.8",
    "multer": "^2.5.0",
    "body-parser": "^1.20.9",
    "nodemailer": "^10.2.1",
    "vite": "^8.1.6",
    "axios": "^1.20.0",
    "source-map-js": "^1.2.2",
    "postcss-selector-parser": "^6.1.5"
  }
}
