# Disable MultiViews and directory browsing
Options -MultiViews -Indexes

# Disable automatic trailing slash 301 redirects by Apache mod_dir
DirectorySlash Off

RewriteEngine On

# -------------------------------------------------------------
# 1. 301 Redirects for Legacy / Old URLs
# -------------------------------------------------------------
# 301 Redirect old category URLs to clean service URLs
RewriteRule ^services/category/(.*)$ /services/$1 [R=301,L]

# 301 Redirect legacy contact-us to contact
RewriteRule ^contact-us/?$ /contact [R=301,L]

# -------------------------------------------------------------
# 2. Enforce Non-Trailing Slash Canonical Standard
# (Redirect /book/ -> /book, /privacy/ -> /privacy, etc.)
# -------------------------------------------------------------
RewriteCond %{REQUEST_METHOD} =GET
RewriteRule ^(.+)/$ /$1 [R=301,L]

# -------------------------------------------------------------
# 3. Serve Existing Static Files directly (css, js, images, etc.)
# -------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# -------------------------------------------------------------
# 4. Prerendered Static Directory Handling
# If request matches a directory that has index.html, serve that index.html internally
# -------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# -------------------------------------------------------------
# 5. SPA Fallback for React Router Routes
# -------------------------------------------------------------
RewriteRule ^ index.html [L]

# Security Headers
<IfModule mod_headers.c>
  # Protect against clickjacking by denying frame embedding
  Header set X-Frame-Options "DENY"

  # Prevent MIME-type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Enable HTTP Strict Transport Security (HSTS) for 1 year (31536000 seconds) including subdomains and preloading
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Protect against XSS attacks
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Caching & MIME types configuration
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType image/png .png
  AddType application/json .json
  AddType application/manifest+json .webmanifest manifest.json
</IfModule>
